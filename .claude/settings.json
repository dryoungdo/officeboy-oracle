{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(bun *)",
      "Bash(python3 *)",
      "Bash(gh *)",
      "Bash(ghq *)",
      "Bash(curl *)",
      "Bash(tree *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(wc *)",
      "Bash(ln *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(maw *)",
      "Bash(rtk *)",
      "Bash(arra-cli *)",
      "Bash(date *)",
      "Bash(hostname *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(true *)",
      "Bash(false *)",
      "Bash(test *)",
      "Bash([ *)",
      "Skill(rrr)",
      "Skill(learn)",
      "Skill(trace)",
      "Skill(recap)",
      "Skill(forward)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin +*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git commit --amend*)",
      "Bash(git * --no-verify*)",
      "Bash(git push * main*)",
      "Bash(chmod 777*)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(tmux *)",
      "Bash(ps aux*)",
      "Bash(pgrep *)",
      "Bash(kill *)",
      "Bash(killall *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/sop-qa-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/pre-claim-gate.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/iterm-ask-when-remote-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|Glob|Grep|mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/pre-claim-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/skills/glueboy-unique-auto-rrr/hooks/session-start-hook.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/skills/glueboy-unique-auto-rrr/hooks/stop-hook.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $HOME/.claude/skills/glueboy-unique-auto-rrr/hooks/session-end-hook.ts",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "model": "opus",
  "effortLevel": "xhigh"
}
